# ─────────────────────────────────────────────────────────────────────────────
# Environment variables for devfest26-web
#
# Copy to `.env.local` for `npm run dev` (the Next dev server). For the
# Cloudflare Workers runtime (`npm run preview` / `npm run deploy`) the
# AUTH_* / GOOGLE secrets instead come from `.dev.vars` locally and
# `wrangler secret put` in production — see `.dev.vars.example`.
#
# Full reference: docs/environment.md
# ─────────────────────────────────────────────────────────────────────────────

# ── Build-time ──────────────────────────────────────────────────────────────

# "true" (or unset) brings /agenda and /speakers (and the hero "See agenda" CTA,
# the 404 rescue grid, and the /md markdown twins) online. Set to "false" to
# hide them behind 404. See lib/routes.ts.
AGENDA_READY=true

# ── Runtime (auth) ──────────────────────────────────────────────────────────
# Required for Google sign-in + saved sessions. Without them the site runs
# fine but sign-in fails. See auth.ts and docs/accounts-and-favorites.md.

# Auth.js session-signing secret. Generate: openssl rand -base64 32
AUTH_SECRET=

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# (Web application). Authorised redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://devfest.gdgchennai.in/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Not here: GEMINI_API_KEY / GEMINI_MODEL (the Speed Typer's optional Gemini text).
# The code reads those through Cloudflare's env, which `npm run dev` fills from
# `.dev.vars`, not from this file. See .dev.vars.example and docs/environment.md.

# ── Build-time, public (Web Push) ───────────────────────────────────────────
# Public half of the VAPID key pair — safe to expose, inlined into the client
# bundle. Generate alongside VAPID_PRIVATE_KEY, see .dev.vars.example.
# Without it the "Get notified" button on /profile no-ops.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Isolated hall preview build ONLY. npm run hall:build sets this automatically.
# Disables production analytics/auth side effects; never set for a full-site deploy.
# NEXT_PUBLIC_HALL_ISOLATED=1

# ── Runtime (DFS 2026 Participant Portal) ───────────────────────────────────
# Admin passcode and HMAC session secret for /dfs-2026-manage and /api/dfs-2026/*.
# Defaults to local development values when unset in development.
DFS_ADMIN_KEY=
DFS_SESSION_SECRET=
# Optional custom directory for dfs-store.json (defaults to ./data/dfs-2026).
# DFS_DATA_DIR=
